# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/

# Environment files — NEVER commit these
.env.local
.env.*.local

# Ignore any per-project local envs
**/.env.local

# Local Claude Code settings that may contain MCP API keys
# (settings.local.json should never be committed)
**/.claude/settings.local.json

# Seed script secrets (local file expected, not committed)
scripts/*.secrets.json

# Executor proxy MITM CA — the PRIVATE key (key+cert bundle) must NEVER be committed.
# Only the public cert (mitmproxy-ca-cert.pem / executor-proxy-ca.crt) is committed.
docker/executor-proxy/ca/mitmproxy-ca.pem

# Vercel local env previews
.vercel/.env*

# .env.example IS committed (it's a template with no real values)

# Production builds
build/
dist/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# CodexQC reports — local handoff artifacts, not for commit
.codex-qc/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Testing
coverage/
.nyc_output/

# Misc
*.pem

# Executor proxy MITM CA: keep the PUBLIC cert as a committed audit anchor (overrides
# the *.pem rule above), but the private-key bundle stays ignored (rule near the top).
!docker/executor-proxy/ca/mitmproxy-ca-cert.pem

# Scaffold temp dir (can be deleted when Windows releases the handle)
nextinit/

# Superpowers plugin workspace (local brainstorming artifacts)
.superpowers/

# Claude Code local settings (machine-specific permissions)
.claude/

# Supabase CLI temp files
supabase/.temp/

.vercel

# Hermes MCP server stderr capture (local runtime noise)
mcp_stderr.txt

# Rig dispatcher isolated build workspaces (regenerated each build, never committed)
builds/

# Hermes local runtime state
.hermes/

# Dispatcher kill-switch flag (local runtime toggle, never committed)
.dispatcher-paused

# rig boot recovery log (local operational artifact)
rig-boot.log

# Local agent configs that hold credentials
.codex/
